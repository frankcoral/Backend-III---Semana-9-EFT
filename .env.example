# Banco XYZ EFT - variables de ejemplo
# Copiar como .env y reemplazar secretos antes de un despliegue real.
MYSQL_ROOT_PASSWORD=root
SSL_KEYSTORE_PASSWORD=changeit
OAUTH2_DEMO_USER=banco_user
OAUTH2_DEMO_PASSWORD=banco123
OAUTH2_SERVICE_CLIENT_SECRET=banco-service-secret
OAUTH2_WEB_CLIENT_SECRET=banco-web-secret
OAUTH2_MOBILE_CLIENT_SECRET=banco-mobile-secret
OAUTH2_ATM_CLIENT_SECRET=banco-atm-secret

# Entorno demo
DEMO_DATA_ENABLED=true
AUTH_ISSUER_URI=http://localhost:9000
OAUTH2_WEB_REDIRECT_URI=https://localhost:8081/login/oauth2/code/banco-web
JWK_SET_URI=http://auth-server:9000/oauth2/jwks
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Para AWS/RDS se pueden sobrescribir estas URLs.
# CUENTAS_DB_URL=jdbc:mysql://<rds>:3306/banco_cuentas?useSSL=true&serverTimezone=UTC
# PAGOS_DB_URL=jdbc:mysql://<rds>:3306/banco_pagos?useSSL=true&serverTimezone=UTC
# CLIENTES_DB_URL=jdbc:mysql://<rds>:3306/banco_clientes?useSSL=true&serverTimezone=UTC
# CUENTAS_SERVICE_URL=http://cuentas-service

# Spring Batch (ejecución local contra MySQL publicado en 3307)
BATCH_DB_URL=jdbc:mysql://localhost:3307/banco_batch?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
BATCH_DB_USER=root
BATCH_DB_PASSWORD=root
