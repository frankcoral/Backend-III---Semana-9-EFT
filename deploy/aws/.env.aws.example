# Copiar a .env en el host AWS y reemplazar TODOS los valores de ejemplo.
MYSQL_ROOT_PASSWORD=REEMPLAZAR
SSL_KEYSTORE_PASSWORD=REEMPLAZAR
OAUTH2_DEMO_USER=banco_user
OAUTH2_DEMO_PASSWORD=REEMPLAZAR
OAUTH2_SERVICE_CLIENT_SECRET=REEMPLAZAR
OAUTH2_WEB_CLIENT_SECRET=REEMPLAZAR
OAUTH2_MOBILE_CLIENT_SECRET=REEMPLAZAR
OAUTH2_ATM_CLIENT_SECRET=REEMPLAZAR

# URL pública/DNS que aparecerá en el claim iss del JWT.
AUTH_ISSUER_URI=https://auth.example.com
OAUTH2_WEB_REDIRECT_URI=https://web.example.com/login/oauth2/code/banco-web

# Dentro de Docker, el JWKS se obtiene por DNS interno.
JWK_SET_URI=http://auth-server:9000/oauth2/jwks

# Laboratorio: Kafka local del compose.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Producción: sustituir por endpoints RDS/MSK y DEMO_DATA_ENABLED=false.
DEMO_DATA_ENABLED=false
# CLIENTES_DB_URL=jdbc:mysql://HOST_RDS:3306/banco_clientes?useSSL=true&serverTimezone=UTC
# CUENTAS_DB_URL=jdbc:mysql://HOST_RDS:3306/banco_cuentas?useSSL=true&serverTimezone=UTC
# PAGOS_DB_URL=jdbc:mysql://HOST_RDS:3306/banco_pagos?useSSL=true&serverTimezone=UTC
# KAFKA_BOOTSTRAP_SERVERS=broker1:9092,broker2:9092

# BATCH_DB_URL=jdbc:mysql://HOST_RDS:3306/banco_batch?useSSL=true&serverTimezone=UTC
# BATCH_DB_USER=usuario_batch
# BATCH_DB_PASSWORD=REEMPLAZAR
